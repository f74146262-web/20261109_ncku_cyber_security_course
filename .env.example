# Local or GitHub Codespaces. These are course defaults, not real credentials.
MOODLE_PORT=8080
# Local use: leave empty for http://127.0.0.1:MOODLE_PORT.
# GitHub Codespaces: run `sh scripts/codespace-up.sh`; it fills this with the
# current forwarded HTTPS URL. Do not edit the hosts file.
MOODLE_WWWROOT=
MOODLE_ADMIN_PASSWORD=ClassroomOnly-ChangeMe-2026
DB_PASSWORD=LocalLabDatabaseOnly
DB_ROOT_PASSWORD=LocalLabRootOnly

# Instructor demo only; not needed for student Labs.
# Any HTTPS URL serving labs/examples/moodle-payload.php works.
# Default: https://s.xn--kst.tw/A
# DEMO_PAYLOAD_URL=
# Optional; default: https://s.xn--kst.tw/good-hacker.webp
# DEMO_IMAGE_URL=
# Optional. If omitted, the controller hashes labs/examples/moodle-payload.php.
# DEMO_PAYLOAD_SHA256=
