# Student-editable Apache configuration for the Moodle container.
#
# This file starts with a normal prefork configuration. The Lab asks you to
# change only the values listed in the Lab Guide. Make the edits yourself;
# the instructor answer is in labs/answer/apache.conf and is not mounted.

KeepAlive On

<IfModule mpm_prefork_module>
    StartServers           5
    MinSpareServers        5
    MaxSpareServers        10
    MaxRequestWorkers      150
    ServerLimit            256
    MaxConnectionsPerChild 0
</IfModule>
